Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Global Options:
    Fixed Frame: map
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Plane Cell Count: 12
      Cell Size: 1
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Names: true
      Marker Scale: 0.6
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Description Topic:
        Value: /robot_description
    - Class: rviz_default_plugins/MarkerArray
      Name: Tags
      Enabled: true
      Topic:
        Value: /apriltag/tag_markers
        Durability Policy: Transient Local
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/Image
      Name: Detections
      Enabled: true
      Topic:
        Value: /apriltag/detections/overlay
        Reliability Policy: Best Effort
    - Class: rviz_default_plugins/PoseWithCovariance
      Name: AprilTag Pose
      Enabled: true
      Topic:
        Value: /apriltag/pose
        Reliability Policy: Best Effort
      Color: 255; 25; 0
    - Class: rviz_default_plugins/Odometry
      Name: EKF
      Enabled: true
      Topic:
        Value: /odometry/filtered
        Reliability Policy: Reliable
      Keep: 100
      Covariance:
        Value: false
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 10
      Pitch: 0.6
      Yaw: 0.8
      Focal Point:
        X: 0
        Y: 0
        Z: 0
