<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>apriltag_localization_bringup</name>
  <version>0.1.0</version>
  <description>Launch files, configuration and visualization for AprilTag localization.</description>
  <maintainer email="adeel.m.zahid@gmail.com">Muhammad Adeel Zahid</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>apriltag_detector</exec_depend>
  <exec_depend>apriltag_pose_estimator</exec_depend>
  <exec_depend>apriltag_localization_sim</exec_depend>
  <exec_depend>robot_localization</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>nav2_map_server</exec_depend>
