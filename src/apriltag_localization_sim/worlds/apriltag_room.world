<?xml version="1.0"?>
<sdf version="1.6">
  <world name="apriltag_room">

    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>

    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.8 0.8 0.8 1</background>
    </scene>

    <!-- Ground-truth model states for accuracy analysis. -->
    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros>
        <namespace>/gazebo</namespace>
      </ros>
      <update_rate>50.0</update_rate>
    </plugin>

    <!-- Room walls. Light-coloured so the tags keep a clean quiet zone. -->
    <model name="walls">
      <static>true</static>
      <link name="link">
        <visual name="wall_px">
          <pose>3.1 0 1.0 0 0 0</pose>
          <geometry><box><size>0.1 6.2 2.0</size></box></geometry>
          <material><ambient>0.9 0.9 0.9 1</ambient><diffuse>0.9 0.9 0.9 1</diffuse></material>
        </visual>
        <collision name="wall_px_c">
          <pose>3.1 0 1.0 0 0 0</pose>
          <geometry><box><size>0.1 6.2 2.0</size></box></geometry>
        </collision>
        <visual name="wall_nx">
          <pose>-3.1 0 1.0 0 0 0</pose>
          <geometry><box><size>0.1 6.2 2.0</size></box></geometry>
          <material><ambient>0.9 0.9 0.9 1</ambient><diffuse>0.9 0.9 0.9 1</diffuse></material>
        </visual>
        <collision name="wall_nx_c">
          <pose>-3.1 0 1.0 0 0 0</pose>
          <geometry><box><size>0.1 6.2 2.0</size></box></geometry>
        </collision>
        <visual name="wall_py">
          <pose>0 3.1 1.0 0 0 0</pose>
          <geometry><box><size>6.2 0.1 2.0</size></box></geometry>
          <material><ambient>0.9 0.9 0.9 1</ambient><diffuse>0.9 0.9 0.9 1</diffuse></material>
        </visual>
        <collision name="wall_py_c">
          <pose>0 3.1 1.0 0 0 0</pose>
          <geometry><box><size>6.2 0.1 2.0</size></box></geometry>
        </collision>
        <visual name="wall_ny">
          <pose>0 -3.1 1.0 0 0 0</pose>
          <geometry><box><size>6.2 0.1 2.0</size></box></geometry>
          <material><ambient>0.9 0.9 0.9 1</ambient><diffuse>0.9 0.9 0.9 1</diffuse></material>
        </visual>
        <collision name="wall_ny_c">
          <pose>0 -3.1 1.0 0 0 0</pose>
          <geometry><box><size>6.2 0.1 2.0</size></box></geometry>
        </collision>
      </link>
    </model>

    <!-- Tags. Poses match config/tags.yaml so the estimator ground truth holds. -->
    <include>
      <name>apriltag_0</name>
      <uri>model://apriltag_0</uri>
      <pose>3.0 0 0.5 1.570796 0 -1.570796</pose>
    </include>
    <include>
      <name>apriltag_1</name>
      <uri>model://apriltag_1</uri>
      <pose>-3.0 0 0.5 1.570796 0 1.570796</pose>
    </include>
    <include>
      <name>apriltag_2</name>
      <uri>model://apriltag_2</uri>
      <pose>0 3.0 0.5 1.570796 0 0</pose>
    </include>
    <include>
      <name>apriltag_3</name>
      <uri>model://apriltag_3</uri>
      <pose>0 -3.0 0.5 1.570796 0 3.141593</pose>
    </include>

  </world>
</sdf>
